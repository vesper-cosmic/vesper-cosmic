# Example environment variables — dummy values only.
# Real values live in Vercel → Settings → Environment Variables (never commit them).
# Copy to .env.local for local development.

# ── Auth (admin = Google sign-in with one of these emails) ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAILS=you@example.com

# ── Notion ──
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=00000000000000000000000000000000
NOTION_MEMBERS_DATABASE_ID=00000000000000000000000000000000
NOTION_PRODUCTS_DATABASE_ID=00000000000000000000000000000000
# Customs presets (海關預設) overrides — Notion "Customs Presets" database
NOTION_CUSTOMS_PRESETS_DATABASE_ID=00000000000000000000000000000000
# Combined shipments (合併出貨) — Notion "Shipments" database
NOTION_SHIPMENTS_DATABASE_ID=00000000000000000000000000000000
# Raw-material inventory & cost (原料、進貨紀錄、庫存異動) — three Notion databases
NOTION_MATERIALS_DATABASE_ID=00000000000000000000000000000000
NOTION_PURCHASES_DATABASE_ID=00000000000000000000000000000000
NOTION_STOCK_MOVEMENTS_DATABASE_ID=00000000000000000000000000000000

# ── Email (Gmail is used when set; Resend is the fallback) ──
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=orders@example.com

# ── PayPal Checkout (PAYPAL_ENV=live for real payments) ──
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENV=sandbox

# ── Customs documents: seller / exporter on the commercial invoice ──
SELLER_BUSINESS_NAME=VESPER COSMOS
SELLER_CONTACT_NAME=Your Name
SELLER_ADDRESS_LINE1=No. 1, Example Rd.
SELLER_ADDRESS_LINE2=Banqiao Dist.
SELLER_CITY=New Taipei City
SELLER_POSTAL_CODE=220
SELLER_COUNTRY=Taiwan
SELLER_PHONE=+886 900 000 000
SELLER_EMAIL=hello@example.com
# Optional (統一編號)
SELLER_TAX_ID=

# ── Customs defaults ──
DEFAULT_PACKAGING_WEIGHT_ENVELOPE_G=30
DEFAULT_PACKAGING_WEIGHT_BOX_G=150
CUSTOMS_DEFAULT_DUTY_RATE=0.10
CUSTOMS_ENTRY_FEE_USD=2

# ── Cron (referral balances) ──
CRON_SECRET=replace-with-a-long-random-string
# Cost report: exchange-rate fallback and PayPal fee (your account rates)
FX_FALLBACK_TWD_PER_USD=32
PAYPAL_FEE_PERCENT=4.4
PAYPAL_FEE_FIXED_USD=0.30
